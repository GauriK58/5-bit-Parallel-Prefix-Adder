* meas tran t_pd_min TRIG V(a0) VAL=0.9  RISE=1 TARG V(P0) VAL=0.9 RISE=1
* meas tran t_pd_max TRIG V(a0) VAL=0.9  RISE=1 TARG V(Cout) VAL=0.9  RISE=1


* VClk Clk gnd PULSE(0 1.8 100p 1p 1p 2n 4n)
* VC0 C0 gnd dc 1.8V
* VA0 A0in gnd PULSE(0 1.8 0p 1p 1p 20n 40n)
* VB0 B0in gnd PULSE(0 1.8 0p 1p 1p 10n 20n)
* VA1 A1in gnd PULSE(0 1.8 0p 1p 1p 20n 40n)
* VB1 B1in gnd PULSE(0 1.8 0p 1p 1p 10n 20n)
* VA2 A2in gnd PULSE(0 1.8 0p 1p 1p 20n 40n)
* VB2 B2in gnd PULSE(0 1.8 0p 1p 1p 10n 20n)
* VA3 A3in gnd PULSE(0 1.8 0p 1p 1p 20n 40n)
* VB3 B3in gnd PULSE(0 1.8 0p 1p 1p 10n 20n)
* VA4 A4in gnd PULSE(0 1.8 0p 1p 1p 20n 40n)
* VB4 B4in gnd PULSE(0 1.8 0p 1p 1p 10n 20n)

VClk Clk gnd PULSE(0 1.8 100p 1p 1p 0.8n 1.6n)
VA0 A0_in gnd dc 1.8
VA1 A1_in gnd dc 1.8
VA2 A2_in gnd dc 1.8
VA3 A3_in gnd dc 1.8
VA4 A4_in gnd dc 1.8

VB0 B0_in gnd dc 1.8
VB1 B1_in gnd dc 0
VB2 B2_in gnd dc 0
VB3 B3_in gnd dc 0
VB4 B4_in gnd dc 0

.tran 100p 100n

.control

run
* plot V(Clk) V(A0in)+2 V(B0in)+4 V(A0)+6 V(B0)+8 V(P0)+10 V(G0)+12 V(C1)+14 V(S0)+16
* plot V(Clk) V(A1in)+2 V(B1in)+4 V(A1)+6 V(B1)+8 V(P1)+10 V(G1)+12 V(C2)+14 V(S1)+16
* plot V(Clk) V(A2in)+2 V(B2in)+4 V(A2)+6 V(B2)+8 V(P2)+10 V(G2)+12 V(C3)+14 V(S2)+16
* plot V(Clk) V(A3in)+2 V(B3in)+4 V(A3)+6 V(B3)+8 V(P3)+10 V(G3)+12 V(C4)+14 V(S3)+16
* plot V(Clk) V(A4in)+2 V(B4in)+4 V(A4)+6 V(B4)+8 V(P4)+10 V(G4)+12 V(C5)+14 V(S4)+16

plot V(A0) V(B0)+2 V(A1)+4 V(B1)+6 V(A2)+8 V(B2)+20 V(A3)+12 V(B3)+14 V(A4)+16 V(B4)+18
plot v(clk) V(P0)+2 V(S1_ff)+4 V(S2_ff)+6 V(S3_ff)+8 V(S4_ff)+10 V(Cout_ff)+12    
.endc

.end
